#!/bin/sh
# A wrong (2070) clock once stamped OpenRC's dependency cache with a future
# date. OpenRC copies that date onto every new deptree and saves /run/openrc
# back to /var/cache/rc at shutdown, so new services are never picked up.
# Reset the dates in both places and rebuild.
for d in /run/openrc/init.d /var/cache/rc/init.d; do [ -d "$d" ] && touch "$d"; done
rm -f /run/openrc/deptree /var/cache/rc/deptree /var/cache/rc/depconfig
[ -d /run/openrc ] && rc-update -u >/dev/null 2>&1
rc-update -q add lowbat-poweroff default
rc-update -q add charge-mode default
rc-update -q add backlight-follow-dpms default
rc-update -q add mtk-wifi default
rc-update -q add avahi-daemon default

# No GPU driver (PowerVR GE8300): plain CPU rendering is the least bad path.
# /etc/environment is read by pam_env, so greetd's greeter and the Phosh
# session both get these.
for kv in WLR_RENDERER=pixman GSK_RENDERER=cairo; do
	grep -q "^${kv%%=*}=" /etc/environment 2>/dev/null || echo "$kv" >> /etc/environment
done
exit 0
