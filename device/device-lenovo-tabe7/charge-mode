#!/bin/sh
# Plugging in a charger while the tablet is off makes LK boot the full system
# (androidboot.bootreason=usb). On a weak charger the running system drains
# the battery overnight. So in that case hold the boot here with the panel
# dark and just charge: power key continues to the desktop, unplugging
# powers off.
# ponytail: 2 s charger poll, no on-screen battery level.
grep -q 'androidboot.bootreason=usb' /proc/cmdline || exit 0

ONLINE=/sys/class/power_supply/mt6392-charger/online
BL=/sys/class/backlight/backlight-lcd/bl_power
for e in /sys/class/input/event*; do
	[ "$(cat "$e/device/name")" = mtk-pmic-keys ] && KEYS=/dev/input/${e##*/}
done
# no power key device means no way out of the loop: boot normally instead
[ -n "$KEYS" ] || exit 0

echo "charge-mode: cable power-on, charging with the panel off" > /dev/kmsg
echo 4 > "$BL"
# unplugged: power off (with no cable LK stays off)
(
	while sleep 2; do
		[ "$(cat "$ONLINE" 2>/dev/null)" = 1 ] && continue
		echo "charge-mode: charger unplugged, powering off" > /dev/kmsg
		poweroff
	done
) &
watch=$!
# one evdev event per read: 16 bytes time, type 1 (EV_KEY), code 0x74
# (KEY_POWER), value 1. Blocking reads, so a press never falls into a gap.
while ev=$(dd if="$KEYS" bs=24 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n'); do
	case "$ev" in
	*0100740001000000) break ;;
	esac
done
kill "$watch"
echo "charge-mode: power key, continuing boot" > /dev/kmsg
echo 0 > "$BL"
