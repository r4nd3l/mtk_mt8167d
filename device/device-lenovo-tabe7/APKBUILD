# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-lenovo-tabe7
pkgdesc="Lenovo Tab E7 (TB-7104F)"
pkgver=0.1
pkgrel=7
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-lenovo-tabe7
	mkbootimg
	mtk-mkimage
	postmarketos-base
"
makedepends="devicepkg-dev"
source="deviceinfo
	00-sdlog.sh"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir"/00-sdlog.sh \
		"$pkgdir"/usr/share/mkinitfs/hooks/00-lenovo-tabe7-sdlog.sh
}

nonfree_firmware() {
	pkgdesc="WiFi/BT firmware (added later from downstream nvram)"
	depends=""
	mkdir -p "$subpkgdir"
}

