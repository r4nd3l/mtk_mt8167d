# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-lenovo-tabe7
pkgdesc="Lenovo Tab E7 (TB-7104F)"
pkgver=0.1
pkgrel=35
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck !strip"
install="$pkgname.post-install $pkgname.post-upgrade"
depends="
	avahi
	postmarketos-config-nftables-mdns
	linux-lenovo-tabe7
	mkbootimg
	mtk-mkimage
	postmarketos-base
"
makedepends="devicepkg-dev"
source="deviceinfo
	mdev-helpers.files
	gt912f-lenovo-tb7104f.fw
	gt912f-lenovo-tb7104f.cfg
	touch-firmware.files
	90_lenovo-tabe7.gschema.override
	lowbat-poweroff
	lowbat-poweroff.initd
	charge-mode
	charge-mode.initd
	backlight-follow-dpms
	backlight-follow-dpms.initd
	mtk-wifi.initd
	battery-gauge-state.initd
	upower-lenovo-tabe7.conf
	90-lenovo-tabe7-wifi-mac.conf
	ucm-mt8167-mt6392.conf
	ucm-HiFi.conf
	powervr-modprobe.conf
	rogue_22.67.54.30_v1.fw
	rogue_22.68.54.30_v1.fw
	ROMv2_lm_patch_1_0_hdr.bin
	ROMv2_lm_patch_1_1_hdr.bin
	WIFI_RAM_CODE_8167
	WMT_SOC.cfg"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/mdev-helpers.files \
		"$pkgdir"/usr/share/mkinitfs/files/device-lenovo-tabe7-mdev.files

	# Goodix GT912F (flashless) touch firmware and panel config, taken from
	# the vendor GPL kernel (drivers/input/touchscreen/mediatek/gt912_p98996/
	# include/firmware_default/gt9xx_firmware.h, first 36878 bytes, and
	# CTP_CFG_GROUP0_XY from include/config_default/gt9xx_config.h). The
	# mainline goodix driver uploads the firmware at every power-up and is
	# built in, so both files have to be in the initramfs.
	install -Dm644 "$srcdir"/gt912f-lenovo-tb7104f.fw \
		"$pkgdir"/lib/firmware/goodix/gt912f-lenovo-tb7104f.fw
	install -Dm644 "$srcdir"/gt912f-lenovo-tb7104f.cfg \
		"$pkgdir"/lib/firmware/goodix/gt912f-lenovo-tb7104f.cfg
	install -Dm644 "$srcdir"/touch-firmware.files \
		"$pkgdir"/usr/share/mkinitfs/files/device-lenovo-tabe7-touch-fw.files
	# Office defaults: dark theme, no auto-suspend, rotation lock, no animations
	install -Dm644 "$srcdir"/90_lenovo-tabe7.gschema.override \
		"$pkgdir"/usr/share/glib-2.0/schemas/90_lenovo-tabe7.gschema.override

	# Clean poweroff before the battery runs flat (no fuel gauge yet)
	install -Dm755 "$srcdir"/lowbat-poweroff "$pkgdir"/usr/libexec/lowbat-poweroff
	install -Dm755 "$srcdir"/lowbat-poweroff.initd "$pkgdir"/etc/init.d/lowbat-poweroff
	install -Dm755 "$srcdir"/charge-mode "$pkgdir"/usr/libexec/charge-mode
	install -Dm755 "$srcdir"/charge-mode.initd "$pkgdir"/etc/init.d/charge-mode

	# simpledrm cannot switch the pwm backlight off on DPMS; mirror it
	install -Dm755 "$srcdir"/backlight-follow-dpms "$pkgdir"/usr/libexec/backlight-follow-dpms
	install -Dm755 "$srcdir"/backlight-follow-dpms.initd "$pkgdir"/etc/init.d/backlight-follow-dpms

	# MT8167 connsys Wi-Fi/BT bring-up (manual start until proven stable)
	install -Dm755 "$srcdir"/mtk-wifi.initd "$pkgdir"/etc/init.d/mtk-wifi
	install -Dm755 "$srcdir"/battery-gauge-state.initd "$pkgdir"/etc/init.d/battery-gauge-state
	install -Dm644 "$srcdir"/upower-lenovo-tabe7.conf \
		"$pkgdir"/etc/UPower/UPower.conf.d/90-lenovo-tabe7.conf
	install -Dm644 "$srcdir"/90-lenovo-tabe7-wifi-mac.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/90-lenovo-tabe7-wifi-mac.conf
	install -Dm644 "$srcdir"/ucm-mt8167-mt6392.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/mt8167-mt6392/mt8167-mt6392.conf
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/mt8167-mt6392/HiFi.conf
	install -Dm644 "$srcdir"/powervr-modprobe.conf \
		"$pkgdir"/etc/modprobe.d/powervr.conf
}

nonfree_firmware() {
	pkgdesc="Wi-Fi/BT (connsys) firmware from the stock TB-7104F vendor image, PowerVR GPU firmware"
	depends="openmttools"
	local f
	for f in ROMv2_lm_patch_1_0_hdr.bin ROMv2_lm_patch_1_1_hdr.bin \
		 WIFI_RAM_CODE_8167 WMT_SOC.cfg; do
		install -Dm644 "$srcdir"/$f "$subpkgdir"/lib/firmware/$f
	done
	# PowerVR GE8300, from gitlab.freedesktop.org/imagination/linux-firmware (powervr)
	for f in rogue_22.67.54.30_v1.fw rogue_22.68.54.30_v1.fw; do
		install -Dm644 "$srcdir"/$f "$subpkgdir"/lib/firmware/powervr/$f
	done
}

