# Maintainer: matemiller992 <matemiller992@users.noreply.github.com>
pkgname=openmttools
pkgver=0_git20260411
pkgrel=0
pkgdesc="Open replacements for MediaTek wmt_loader and connsys launcher (WMT Wi-Fi/BT bring-up)"
url="https://github.com/lscorcia/openmttools"
arch="aarch64"
license="GPL-3.0-or-later"
options="!check !pmb:crossdirect"
makedepends="linux-headers"
source="$pkgname-master.tar.gz::https://github.com/lscorcia/openmttools/archive/refs/heads/master.tar.gz"
builddir="$srcdir/openmttools-master"

build() {
	make CC="${CC:-gcc}" CFLAGS="-I. $CFLAGS"
}

package() {
	install -Dm755 bin/mtinit "$pkgdir"/usr/bin/mtinit
	install -Dm755 bin/mtdaemon "$pkgdir"/usr/bin/mtdaemon
}

sha512sums="
