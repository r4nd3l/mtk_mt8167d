From: Mate Molnar <matemolnar88@gmail.com>
Date: Fri, 23 Oct 2026 12:30:00 +0200
Subject: [PATCH] pvr: valid PDS uniform base in SIPF v1 transfer primitive blocks

Primitive-based (FAST_2D) transfers, used for multi-rect and double-stride
copies, never worked on the GE8300: the primitive block's
TA_STATE_PDS_UNIFORMDATABASE was 0 and the core fetches from it anyway,
so the fragment DM faulted at address 0 / 0x140 and locked up (every
odd-width image -> buffer copy). The vendor DDK writes a real address
there and always sets pds_tri_merge_disable; do both on SIPF v1.
---
--- a/src/imagination/vulkan/pvr_arch_job_transfer.c
+++ b/src/imagination/vulkan/pvr_arch_job_transfer.c
@@ -3353,6 +3353,10 @@
                                          uint32_t **const cs_ptr_out)
 {
    uint32_t *cs_ptr = *cs_ptr_out;
+   /* SIPF v1 = Series8XE (GE8300), see pvr_has_sipf_v1() below. */
+   const bool sipf_v1 =
+      PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format) &&
+      !PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format_v2);
 
    pvr_csb_pack (cs_ptr, TA_STATE_PDS_SHADERBASE, shader_base) {
       shader_base.addr = PVR_DEV_ADDR(state->pds_shader_task_offset);
@@ -3399,9 +3403,13 @@
    }
    cs_ptr++;
 
-   /* PDS uniform program not used. */
+   /* PDS uniform program not used. SIPF v1 (GE8300) fetches from this base
+    * anyway: 0 faults the fragment DM (address 0 / 0x140) and locks up the
+    * GPU. The vendor DDK always writes a real address, so point it at the
+    * texture state data, which is valid for the lifetime of the job.
+    */
    pvr_csb_pack (cs_ptr, TA_STATE_PDS_UNIFORMDATABASE, base) {
-      base.addr = PVR_DEV_ADDR(0U);
+      base.addr = PVR_DEV_ADDR(sipf_v1 ? state->tex_state_data_offset : 0U);
    }
    cs_ptr++;
 
@@ -3410,7 +3418,9 @@
          ALIGN_POT(state->common_ptr,
                    ROGUE_TA_STATE_PDS_SIZEINFO2_USC_SHAREDSIZE_UNIT_SIZE) /
          ROGUE_TA_STATE_PDS_SIZEINFO2_USC_SHAREDSIZE_UNIT_SIZE;
-      info.pds_tri_merge_disable = !PVR_HAS_ENHANCEMENT(dev_info, 42307);
+      /* The vendor DDK sets it unconditionally on SIPF v1. */
+      info.pds_tri_merge_disable =
+         !PVR_HAS_ENHANCEMENT(dev_info, 42307) || sipf_v1;
       info.pds_batchnum = 0U;
    }
    cs_ptr++;
