From: Mate Molnar <matemolnar88@gmail.com>
Date: Wed, 21 Oct 2026 18:30:00 +0200
Subject: [PATCH] pvr: implement the transfer queue ISP stream for simple internal parameter format v1

Series8XE cores with simple_internal_parameter_format but without the _v2
variant (GE8300, 22.V.54.30) took the classic control stream and ISP state
path, which the hardware cannot parse: the fragment DM locks up on the first
transfer job (clears, copies) with an MMU fault at a bogus address.

Layouts reverse engineered from the vendor DDK 1.9 transfer queue for
22.40.54.30 (libsrv_um.so, RGXQueueTransfer -> TQ3D prepare):

- ISP state block, 16 bytes: a 32-bit vertex format word ([8:5] vertex_total,
  [18:10] varying bytes per ISP vertex), STATE_ISPCTL, STATE_ISPA, pad.
- Control stream entries are 8 bytes, 16 per 128-byte chunk.
  PRIMITIVE: dword0 = 1 << 3 | ((prims - 1) >> 2) << 5 | prim_mask << 8,
  dword1 = (prim block heap-relative address >> 2) | 1.
  LINK: dword0 = 1, dword1 = (next chunk >> 2) & ~1.
  TERMINATE: bit 1 of dword0 of the last primitive entry.
- CR_ISP_RGN.cs_size_ipf_creq_pf = min(entries, 31), 31 when linked.

Index words, ISP vertex words, PDS state and the block order already match
the SIPF path. Not handled yet: 3D (volume) sources use 3 TSP dwords per
vertex in v1 instead of 4.
---
--- a/src/imagination/vulkan/pvr_arch_job_transfer.c
+++ b/src/imagination/vulkan/pvr_arch_job_transfer.c
@@ -3422,6 +3422,17 @@
    *cs_ptr_out = cs_ptr;
 }
 
+/* Simple internal parameter format version 1 (Series8XE cores such as the
+ * GE8300, BVNC 22.V.54.30). The hardware consumes a 32-bit vertex format word
+ * and 8-byte ISP control stream entries. Layouts taken from the vendor DDK 1.9
+ * transfer queue for 22.40.54.30; see NOTES-sipf-v1.md in the lenovo-tabe7 port.
+ */
+static inline bool pvr_has_sipf_v1(const struct pvr_device_info *dev_info)
+{
+   return PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format) &&
+          !PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format_v2);
+}
+
 static void pvr_isp_prim_block_isp_state(const struct pvr_device_info *dev_info,
                                          UNUSED uint32_t tsp_comp_format_in_dw,
                                          uint32_t tsp_data_size_in_bytes,
@@ -3451,6 +3462,17 @@
          vert_fmt.vf_vertex_total = num_isp_vertices - 1U;
       }
       cs_ptr += pvr_cmd_length(IPF_VERTEX_FORMAT_WORD_SIPF2);
+   } else if (pvr_has_sipf_v1(dev_info)) {
+      const uint32_t tsp_bytes_per_vertex =
+         tsp_data_size_in_bytes / num_isp_vertices;
+
+      /* SIPF v1 vertex format word, 32 bits:
+       *   [8:5]   vertex_total (vertices - 1)
+       *   [18:10] varying data per ISP vertex in bytes
+       * No primitive_total, raw flags or state size fields exist in v1.
+       */
+      *cs_ptr++ = ((num_isp_vertices - 1U) & 0xFU) << 5 |
+                  (tsp_bytes_per_vertex & 0x1FFU) << 10;
    }
 
    /* ISP state words. */
@@ -3469,6 +3491,13 @@
    }
    cs_ptr += pvr_cmd_length(TA_STATE_ISPA);
 
+   if (pvr_has_sipf_v1(dev_info)) {
+      /* Pad the ISP state block to 16 bytes (8-byte alignment of what follows). */
+      *cs_ptr++ = 0U;
+      *cs_ptr_out = cs_ptr;
+      return;
+   }
+
    if (has_simple_internal_parameter_format_v2) {
       *cs_ptr_out = cs_ptr;
       return;
@@ -4062,6 +4091,11 @@
    uint32_t num_region_arrays;
    uint32_t total_stream_size;
    bool was_linked = false;
+   /* SIPF v1: terminate is a flag in the last primitive entry, and the ISP
+    * needs the entry count in CR_ISP_RGN.
+    */
+   uint32_t *v1_last_prim_entry = NULL;
+   uint32_t v1_num_entries = 0U;
    uint32_t rem_mappings;
    uint32_t num_sources;
    uint32_t *blk_cs_ptr;
@@ -4358,8 +4392,10 @@
 
          while (rem_mappings > 0U) {
             const uint32_t min_free_ctrl_stream_words =
-               PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format) ? 2
-                                                                           : 3;
+               pvr_has_sipf_v1(dev_info) ? 4
+               : PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format)
+                  ? 2
+                  : 3;
             const uint32_t num_mappings =
                MIN2(max_mappings_per_pb, rem_mappings);
             struct pvr_rect_mapping *mappings = NULL;
@@ -4374,8 +4410,15 @@
                   num_region_arrays *
                   PVR_DW_TO_BYTES(ROGUE_IPF_CONTROL_STREAM_SIZE_DWORDS);
 
-               if (PVR_HAS_FEATURE(dev_info,
-                                   simple_internal_parameter_format_v2)) {
+               if (pvr_has_sipf_v1(dev_info)) {
+                  /* v1 LINK entry: dword0 = 1 (link), dword1 = heap relative
+                   * address of the next 128-byte chunk >> 2, bit 0 clear.
+                   */
+                  cs_ptr[0] = 1U;
+                  cs_ptr[1] =
+                     (uint32_t)(next_region_array_vaddr.addr >> 2) & ~1U;
+               } else if (PVR_HAS_FEATURE(dev_info,
+                                          simple_internal_parameter_format_v2)) {
                   uint32_t link_addr;
 
                   pvr_csb_pack (&link_addr,
@@ -4403,7 +4446,8 @@
                   num_region_arrays * ROGUE_IPF_CONTROL_STREAM_SIZE_DWORDS;
                free_ctrl_stream_words = ROGUE_IPF_CONTROL_STREAM_SIZE_DWORDS;
 
-               was_linked = PVR_HAS_FEATURE(dev_info, ipf_creq_pf);
+               was_linked = PVR_HAS_FEATURE(dev_info, ipf_creq_pf) ||
+                            pvr_has_sipf_v1(dev_info);
             }
 
             if (fill_blit)
@@ -4433,8 +4477,26 @@
 
             prim_blk_addr.addr += stream_start_offset;
 
-            if (PVR_HAS_FEATURE(dev_info,
-                                simple_internal_parameter_format_v2)) {
+            if (pvr_has_sipf_v1(dev_info)) {
+               /* v1 PRIMITIVE entry, 8 bytes:
+                *   dword0: bit 3 set, [7:5] = (prims - 1) >> 2,
+                *           [15:8] = one valid bit per triangle (2 per mapping),
+                *           bit 0 = link (0 here), bit 1 = terminate (set later
+                *           on the last entry).
+                *   dword1: heap relative primitive block address >> 2, bit 0 set.
+                */
+               const uint32_t num_prims = 2U * num_mappings;
+
+               cs_ptr[0] = 1U << 3 | (((num_prims - 1U) >> 2) & 7U) << 5 |
+                           ((1U << num_prims) - 1U) << 8;
+               cs_ptr[1] = (uint32_t)(prim_blk_addr.addr >> 2) | 1U;
+               v1_last_prim_entry = cs_ptr;
+               v1_num_entries++;
+               cs_ptr += 2;
+
+               free_ctrl_stream_words -= 2;
+            } else if (PVR_HAS_FEATURE(dev_info,
+                                       simple_internal_parameter_format_v2)) {
                uint8_t *cs_byte_ptr = (uint8_t *)cs_ptr;
                uint32_t tmp;
 
@@ -4536,7 +4598,11 @@
    if (PVR_HAS_FEATURE(dev_info, ipf_creq_pf))
       assert((num_region_arrays > 1) == was_linked);
 
-   if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format_v2)) {
+   if (pvr_has_sipf_v1(dev_info)) {
+      /* v1 has no terminate entry: bit 1 of the last primitive entry. */
+      if (v1_last_prim_entry)
+         v1_last_prim_entry[0] |= 2U;
+   } else if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format_v2)) {
       uint8_t *cs_byte_ptr = (uint8_t *)cs_ptr;
       uint32_t tmp;
 
@@ -4564,8 +4630,16 @@
       reg.mode_type = ROGUE_CR_ISP_RENDER_MODE_TYPE_FAST_2D;
    }
 
-   if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format_v2) &&
-       PVR_HAS_FEATURE(dev_info, ipf_creq_pf)) {
+   if (pvr_has_sipf_v1(dev_info)) {
+      pvr_csb_pack (&regs->isp_rgn, CR_ISP_RGN_SIPF, isp_rgn) {
+         /* v1: number of control stream entries, 31 when the stream is
+          * linked or longer than 31 entries.
+          */
+         isp_rgn.cs_size_ipf_creq_pf =
+            was_linked ? 31U : MIN2(v1_num_entries, 31U);
+      }
+   } else if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format_v2) &&
+              PVR_HAS_FEATURE(dev_info, ipf_creq_pf)) {
       pvr_csb_pack (&regs->isp_rgn, CR_ISP_RGN_SIPF, isp_rgn) {
          /* Bit 0 in CR_ISP_RGN.cs_size_ipf_creq_pf is used to indicate the
           * presence of a link.
