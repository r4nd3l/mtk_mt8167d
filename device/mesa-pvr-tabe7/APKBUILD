# Maintainer: Mate Molnar <matemolnar88@gmail.com>
# Mesa's Imagination (PowerVR Rogue) Vulkan driver only, built from the same
# Mesa release as Alpine's mesa, with the local patches needed for the GE8300
# (22.V.54.30, simple internal parameter format v1). Replaces the ICD from
# mesa-vulkan-imagination; everything else (llvmpipe etc.) stays Alpine's mesa.
# No LLVM: the PowerVR compiler (pco) does not need it, and llvm-config cannot
# run in a cross build.
pkgname=mesa-pvr-tabe7
pkgver=26.2.5
pkgrel=30
pkgdesc="Mesa PowerVR Vulkan driver with GE8300 (SIPF v1) patches"
url="https://www.mesa3d.org"
arch="aarch64"
license="MIT SGI-B-2.0 BSL-1.0"
# !strip: keep the symbol table for gdb/perf on the device (~6 % bigger apk)
options="!check !strip pmb:cross-native2"
replaces="mesa-vulkan-imagination"
makedepends_build="
	bison
	libclc-dev
	mesa-clc
	flex
	glslang
	meson
	py3-cparser
	py3-mako
	py3-packaging
	py3-yaml
	python3
	wayland-dev
	"
makedepends_host="
	expat-dev
	libdrm-dev
	libxml2-dev
	wayland-dev
	wayland-protocols
	zlib-dev
	zstd-dev
	"
source="https://mesa.freedesktop.org/archive/mesa-$pkgver.tar.xz
	0001-pvr-transfer-simple-internal-parameter-format-v1.patch
	0002-pvr-render-target-macrotiles-for-simple-parameter-format-v1.patch
	0003-pvr-valid-macrotile-array-address-for-simple-parameter-format-v1.patch
	0004-pvr-v1-region-header-and-tpc-headroom.patch
	0005-pvr-debug-pbe-clip-scale.patch
	0006-pvr-debug-region-clip-scale.patch
	0007-pvr-debug-dump-region-headers.patch
	0008-pvr-v1-terminate-clip-16px-blocks.patch
	0009-pvr-v1-bgobjdepth-always-f32.patch
	0010-pvr-debug-isp-tiles-in-flight.patch
	0011-pco-lower-alpha-to-coverage-only-when-used.patch
	0012-pco-sample-mask-check-only-when-partial.patch
	0013-pco-predicate-only-small-if-bodies.patch
	0014-pvr-reuse-spill-scratch-memory-per-cmd-buffer.patch
	0015-wsi-cpu-image-64-byte-stride.patch
	"
builddir="$srcdir/mesa-$pkgver"

build() {
	# cross-native2 does not pass abuild CFLAGS: without this the driver is built -O0
	abuild-meson \
		-Dplatforms=wayland \
		-Dgallium-drivers= \
		-Dvulkan-drivers=imagination \
		-Dvulkan-layers= \
		-Dllvm=disabled \
		-Dmesa-clc=system \
		-Dprecomp-compiler=system \
		-Dglx=disabled \
		-Degl=disabled \
		-Dgbm=disabled \
		-Dgles1=disabled \
		-Dgles2=disabled \
		-Dopengl=false \
		-Dtools= \
		-Dbuild-tests=false \
		-Dzstd=enabled \
		-Doptimization=2 \
		output
	# respect pmbootstrap jobs: plain ninja runs nproc+2 jobs and ran the host out of memory
	# Several sources include generated headers (pco_usclib.h, git_sha1.h, ...)
	# without a meson dependency; with few jobs the compiles can win the race.
	# Generate every custom-command header first.
	ninja -C output -j "${JOBS:-4}" $(ninja -C output -t targets all |
		sed -n 's/^\([^:]*\.h\): CUSTOM_COMMAND.*/\1/p')
	meson compile -C output -j "${JOBS:-4}"
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	# only the ICD and its json stay; drop anything else meson installs
	find "$pkgdir" -type f ! -name 'libvulkan_powervr_mesa*.so' ! -name 'powervr_mesa_icd*.json' -delete
	find "$pkgdir" -type d -empty -delete
}

