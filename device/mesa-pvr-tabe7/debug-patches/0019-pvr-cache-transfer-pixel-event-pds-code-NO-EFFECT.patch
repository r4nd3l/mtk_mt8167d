From: Mate Molnar <matemolnar88@gmail.com>
Date: Sat, 24 Oct 2026 10:00:00 +0200
Subject: [PATCH] pvr: upload the transfer pixel event PDS code once per context

The pixel event PDS code only depends on the render target count, but it was
generated and uploaded with every transfer, into PDS heap addresses that
earlier programs (e.g. destroyed pipelines) had used. On the GE8300 this
lines up with rare fragment-DM lockups during back-to-back transfers right
after a render workload (PDSRW write to a garbage address). Upload the code
once per render target count with the EOT shaders and only upload the data
segment per transfer, as the old TODO suggested.
---
--- a/src/imagination/vulkan/pvr_job_context.h
+++ b/src/imagination/vulkan/pvr_job_context.h
@@ -150,6 +150,10 @@
 
    struct pvr_suballoc_bo *usc_eot_bos[PVR_TRANSFER_MAX_RENDER_TARGETS];
    unsigned usc_eot_usc_temps[PVR_TRANSFER_MAX_RENDER_TARGETS];
+   /* Pixel event PDS code per render target count; only the data segment is
+    * uploaded per transfer.
+    */
+   struct pvr_pds_upload pds_event_code[PVR_TRANSFER_MAX_RENDER_TARGETS];
 
    struct pvr_pds_upload pds_unitex_code[PVR_TRANSFER_MAX_TEXSTATE_DMA]
                                         [PVR_TRANSFER_MAX_UNIFORM_DMA];
--- a/src/imagination/vulkan/pvr_arch_job_context.c
+++ b/src/imagination/vulkan/pvr_arch_job_context.c
@@ -1265,9 +1265,50 @@
       ctx->usc_eot_usc_temps[i] = pco_shader_data(eot)->common.temps;
       ralloc_free(eot);
 
+      if (result == VK_SUCCESS) {
+         /* The pixel event code only depends on the emit count. Uploading it
+          * per transfer put fresh PDS code at addresses that earlier programs
+          * (e.g. freed pipelines) used; on the GE8300 the PDS then sometimes
+          * ran stale code and wrote to garbage addresses (guilty lockup).
+          */
+         struct pvr_pds_event_program program = {
+            .num_emit_word_pairs = i + 1,
+         };
+         uint32_t *code;
+
+         pvr_pds_set_sizes_pixel_event(&program, &device->pdevice->dev_info);
+         code = vk_alloc(&device->vk.alloc,
+                         PVR_DW_TO_BYTES(program.code_size),
+                         8,
+                         VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+         if (!code) {
+            pvr_bo_suballoc_free(ctx->usc_eot_bos[i]);
+            result = vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
+         } else {
+            pvr_pds_generate_pixel_event_code_segment(
+               &program,
+               code,
+               &device->pdevice->dev_info);
+            result = pvr_gpu_upload_pds(device,
+                                        NULL,
+                                        0,
+                                        0,
+                                        code,
+                                        program.code_size,
+                                        ROGUE_CR_EVENT_PIXEL_PDS_CODE_ADDR_ALIGNMENT,
+                                        ROGUE_CR_EVENT_PIXEL_PDS_CODE_ADDR_ALIGNMENT,
+                                        &ctx->pds_event_code[i]);
+            vk_free(&device->vk.alloc, code);
+            if (result != VK_SUCCESS)
+               pvr_bo_suballoc_free(ctx->usc_eot_bos[i]);
+         }
+      }
+
       if (result != VK_SUCCESS) {
-         for (uint32_t j = 0; j < i; j++)
+         for (uint32_t j = 0; j < i; j++) {
+            pvr_bo_suballoc_free(ctx->pds_event_code[j].pvr_bo);
             pvr_bo_suballoc_free(ctx->usc_eot_bos[j]);
+         }
 
          return result;
       }
@@ -1279,8 +1320,10 @@
 static void pvr_transfer_eot_shaders_fini(struct pvr_device *device,
                                           struct pvr_transfer_ctx *ctx)
 {
-   for (uint32_t i = 0; i < ARRAY_SIZE(ctx->usc_eot_bos); i++)
+   for (uint32_t i = 0; i < ARRAY_SIZE(ctx->usc_eot_bos); i++) {
+      pvr_bo_suballoc_free(ctx->pds_event_code[i].pvr_bo);
       pvr_bo_suballoc_free(ctx->usc_eot_bos[i]);
+   }
 }
 
 static VkResult pvr_transfer_ctx_shaders_init(struct pvr_device *device,
--- a/src/imagination/vulkan/pvr_arch_job_transfer.c
+++ b/src/imagination/vulkan/pvr_arch_job_transfer.c
@@ -1197,25 +1197,20 @@
                                              staging_buffer,
                                              dev_info);
 
-   /* TODO: We can save some memory by generating a code segment for each
-    * rt_count, which at the time of writing is a maximum of 3, in
-    * pvr_setup_transfer_eot_shaders() when we setup the corresponding EOT
-    * USC programs.
+   /* The code segment is uploaded once per render target count in
+    * pvr_transfer_eot_shaders_init(); only the data goes per transfer.
     */
-   pvr_pds_generate_pixel_event_code_segment(&program,
-                                             staging_buffer + program.data_size,
-                                             dev_info);
-
    result = pvr_arch_cmd_buffer_upload_pds(
       transfer_cmd->cmd_buffer,
       staging_buffer,
       program.data_size,
       ROGUE_CR_EVENT_PIXEL_PDS_DATA_ADDR_ALIGNMENT,
-      staging_buffer + program.data_size,
-      program.code_size,
-      ROGUE_CR_EVENT_PIXEL_PDS_CODE_ADDR_ALIGNMENT,
+      NULL,
+      0,
+      0,
       ROGUE_CR_EVENT_PIXEL_PDS_DATA_ADDR_ALIGNMENT,
       &pds_upload);
+   pds_upload.code_offset = ctx->pds_event_code[rt_count - 1U].code_offset;
    vk_free(&device->vk.alloc, staging_buffer);
    if (result != VK_SUCCESS)
       return result;
