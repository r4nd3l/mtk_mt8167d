From: Mate Molnar <matemolnar88@gmail.com>
Date: Fri, 23 Oct 2026 12:00:00 +0200
Subject: [PATCH] pvr: PVR_TQ_DEBUG dump of transfer mappings, control stream and kick regs (debug)

---
--- a/src/imagination/vulkan/pvr_arch_job_transfer.c
+++ b/src/imagination/vulkan/pvr_arch_job_transfer.c
@@ -25,6 +25,8 @@
 #include <stdbool.h>
 #include <stddef.h>
 #include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
 #include <vulkan/vulkan.h>
 
@@ -4620,6 +4622,44 @@
       cs_ptr += pvr_cmd_length(IPF_CONTROL_STREAM);
    }
 
+   /* ponytail: temporary debug dump of the transfer control stream. */
+   if (getenv("PVR_TQ_DEBUG")) {
+      const uint32_t *cs0 = pvr_bo_suballoc_get_map_addr(pvr_cs_bo);
+      fprintf(stderr,
+              "TQ pass %u/%u sources=%u prim_blks=%u entries=%u linked=%d "
+              "dst %ux%u stride %u layout %d\n",
+              state->pass_idx, state->custom_mapping.pass_count, num_sources,
+              num_prim_blks, v1_num_entries, was_linked,
+              transfer_cmd->dst.width, transfer_cmd->dst.height,
+              transfer_cmd->dst.stride, transfer_cmd->dst.mem_layout);
+      for (uint32_t s = 0; s < transfer_cmd->source_count; s++) {
+         const struct pvr_transfer_cmd_source *src = &transfer_cmd->sources[s];
+         for (uint32_t m = 0; m < src->mapping_count; m++)
+            fprintf(stderr, "  src%u map%u src %d,%d %ux%u -> dst %d,%d %ux%u\n", s, m,
+                    src->mappings[m].src_rect.offset.x, src->mappings[m].src_rect.offset.y,
+                    src->mappings[m].src_rect.extent.width, src->mappings[m].src_rect.extent.height,
+                    src->mappings[m].dst_rect.offset.x, src->mappings[m].dst_rect.offset.y,
+                    src->mappings[m].dst_rect.extent.width, src->mappings[m].dst_rect.extent.height);
+      }
+      if (pass) {
+         for (uint32_t s = 0; s < pass->source_count; s++)
+            for (uint32_t m = 0; m < pass->sources[s].mapping_count; m++)
+               fprintf(stderr, "  pass src%u map%u src %d,%d %ux%u -> dst %d,%d %ux%u\n", s, m,
+                       pass->sources[s].mappings[m].src_rect.offset.x,
+                       pass->sources[s].mappings[m].src_rect.offset.y,
+                       pass->sources[s].mappings[m].src_rect.extent.width,
+                       pass->sources[s].mappings[m].src_rect.extent.height,
+                       pass->sources[s].mappings[m].dst_rect.offset.x,
+                       pass->sources[s].mappings[m].dst_rect.offset.y,
+                       pass->sources[s].mappings[m].dst_rect.extent.width,
+                       pass->sources[s].mappings[m].dst_rect.extent.height);
+      }
+      fprintf(stderr, "  cs:");
+      for (uint32_t i = 0; i < MIN2(total_stream_size / 4U, 96U); i++)
+         fprintf(stderr, "%s%08x", i % 8 ? " " : "\n   ", cs0[i]);
+      fprintf(stderr, "\n");
+   }
+
    pvr_csb_pack (&regs->isp_mtile_base, CR_ISP_MTILE_BASE, reg) {
       reg.addr =
          PVR_DEV_ADDR(pvr_cs_bo->dev_addr.addr -
@@ -6001,6 +6041,27 @@
 
       pvr_submit_info_stream_init(ctx, prep_data, cmd);
       pvr_submit_info_flags_init(dev_info, prep_data, &cmd->flags);
+
+      if (getenv("PVR_TQ_DEBUG")) {
+         const struct pvr_winsys_transfer_regs *r = &prep_data->state.regs;
+         fprintf(stderr,
+                 "TQ kick %u/%u: frag_screen %08x isp_aa %08x bgobjvals %08x isp_ctl %08x "
+                 "mtile_base %016llx mtile_size %08x render %08x origin %08x rgn %08x\n"
+                 "  pds_bgnd0 %016llx bgnd1 %016llx bgnd3 %016llx event pds code %08x data %08x info %08x\n"
+                 "  usc_clear %08x %08x %08x %08x pix_out %08x\n",
+                 i, submit->prep_count, r->frag_screen, r->isp_aa, r->isp_bgobjvals,
+                 r->isp_ctl, (unsigned long long)r->isp_mtile_base, r->isp_mtile_size,
+                 r->isp_render, r->isp_render_origin, r->isp_rgn,
+                 (unsigned long long)r->pds_bgnd0_base, (unsigned long long)r->pds_bgnd1_base,
+                 (unsigned long long)r->pds_bgnd3_sizeinfo, r->event_pixel_pds_code,
+                 r->event_pixel_pds_data, r->event_pixel_pds_info, r->usc_clear_register0,
+                 r->usc_clear_register1, r->usc_clear_register2, r->usc_clear_register3,
+                 r->usc_pixel_output_ctrl);
+         for (uint32_t k = 0; k < ARRAY_SIZE(r->pbe_wordx_mrty); k++)
+            if (r->pbe_wordx_mrty[k])
+               fprintf(stderr, "  pbe[%u] %016llx\n", k,
+                       (unsigned long long)r->pbe_wordx_mrty[k]);
+      }
    }
 }
 
