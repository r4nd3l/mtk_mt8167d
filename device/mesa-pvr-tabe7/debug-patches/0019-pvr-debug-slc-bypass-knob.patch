From: Mate Molnar <matemolnar88@gmail.com>
Date: Sat, 24 Oct 2026 11:00:00 +0200
Subject: [PATCH] pvr: PVR_SLC_BYPASS=all|cpu debug knob (experiment)

---
--- a/src/imagination/vulkan/winsys/powervr/pvr_drm_bo.c
+++ b/src/imagination/vulkan/winsys/powervr/pvr_drm_bo.c
@@ -26,6 +26,8 @@
 #include <stdbool.h>
 #include <stddef.h>
 #include <stdint.h>
+#include <string.h>
+#include <stdlib.h>
 #include <sys/mman.h>
 #include <sys/types.h>
 #include <vulkan/vulkan.h>
@@ -177,6 +179,17 @@
    if (ws_flags & PVR_WINSYS_BO_FLAG_CPU_ACCESS)
       drm_flags |= DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS;
 
+   /* ponytail: experiment knob, PVR_SLC_BYPASS=all|cpu makes buffers bypass
+    * the GPU SLC (all buffers / only CPU-written ones).
+    */
+   {
+      const char *e = getenv("PVR_SLC_BYPASS");
+
+      if (e && (!strcmp(e, "all") ||
+                (!strcmp(e, "cpu") && (ws_flags & PVR_WINSYS_BO_FLAG_CPU_ACCESS))))
+         drm_flags |= DRM_PVR_BO_BYPASS_DEVICE_CACHE;
+   }
+
    return drm_flags;
 }
 
