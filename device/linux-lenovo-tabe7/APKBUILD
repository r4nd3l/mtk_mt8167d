# Kernel config based on: arch/arm64/configs/defconfig
# Maintainer: matemiller992 <matemiller992@users.noreply.github.com>

pkgname=linux-lenovo-tabe7
pkgver=7.3.0_rc5
pkgrel=43
pkgdesc="Lenovo Tab E7 (TB-7104F) kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="lenovo-tabe7"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="bash bison clang findutils flex installkernel lld llvm openssl-dev perl zstd"

# Luca Leonardo Scorcia's MT8167 branch, which carries the MT6392 PMIC and
# display work this device depends on.
_repo="https://github.com/lscorcia/linux"
_commit="1e18b5439b06e4c670eb83a6764bde9bcd56ac7b"

source="
	$pkgname-$_commit.tar.gz::$_repo/archive/$_commit.tar.gz
	config-$_flavor.$arch
	mt6392_charger.c
	mt8167-mt6392.c
	mediatek-connectivity.tar.gz
	0001-pwrap-mt8167-slave-bit-order-and-forced-init.patch
	0002-mtk-gpt-defer-irq-until-handler-is-set.patch
	0003-dts-move-ramoops-off-secmon.patch
	0004-mt6392-charger-wireup.patch
	0005-dts-arch-timer-ool-workaround.patch
	0006-dts-enable-mmsys-clocks-and-disp-pwm-backlight.patch
	0007-dts-goodix-gt912f-touchscreen.patch
	0008-dts-default-brightness-5.patch
	0009-dts-vgp1-2v8-for-touch.patch
	0010-goodix-fwupload-wait-for-fw-start.patch
	0011-dts-bma253-accelerometer.patch
	0012-simpledrm-report-dsi-connector.patch
	0013-asoc-mt8167-mt6392-machine-kconfig.patch
	0014-dts-sound-card.patch
	0015-dts-consys-wifi-bt-and-volume-down.patch
	0016-misc-hook-mediatek-connectivity.patch
	0018-clk-mt8167-mfgcfg-runtime-pm.patch
	0019-dts-mt8167-powervr-gpu.patch
	0020-dts-sound-external-speaker-amp.patch
	0021-dts-volume-down-on-keypad-col1.patch
	0022-asoc-mt8167-memif-format.patch
"
builddir="$srcdir/linux-$_commit"

prepare() {
	# the charger driver is a new file, so it is copied in rather than patched
	cp "$srcdir"/mt6392_charger.c "$builddir"/drivers/power/supply/
	cp "$srcdir"/mt8167-mt6392.c "$builddir"/sound/soc/mediatek/mt8167/
	# MediaTek connsys (Wi-Fi/BT) vendor drivers, ported from Luca Leonardo
	# Scorcia's psclassic-consys branch to 7.3 (cfg80211 wdev ops, strncpy
	# shim, of_gpio removal, proc buffer bounds). abuild unpacks the tarball.
	cp -r "$srcdir"/mediatek "$builddir"/drivers/misc/

	default_prepare
	cp "$srcdir"/config-$_flavor.$arch "$builddir"/.config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install LLVM=1 \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	# mkinitfs locates the kernel through this file. Without it it reports
	# "only one kernel release/flavor is supported, found: []" and the
	# install aborts.
	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$pkgname/kernel.release

	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source
}

