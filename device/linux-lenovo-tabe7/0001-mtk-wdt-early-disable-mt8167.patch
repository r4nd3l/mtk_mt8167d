--- a/drivers/watchdog/mtk_wdt.c
+++ b/drivers/watchdog/mtk_wdt.c
@@ -542,4 +542,35 @@
 MODULE_LICENSE("GPL");
 MODULE_AUTHOR("Matthias Brugger <matthias.bgg@gmail.com>");
 MODULE_DESCRIPTION("Mediatek WatchDog Timer Driver");
 MODULE_VERSION(DRV_VERSION);
+
+/*
+ * MT8167/MT8516 bring-up: the preloader arms the WDT with a hardware timeout
+ * before handing off to the kernel.  The MTK_WATCHDOG platform driver probes
+ * late (after the PWRAP->MT6392->regulator->PHY deferred-probe chain resolves),
+ * sometimes after the bootloader timeout expires.  Disable the WDT at
+ * early_initcall (runs ~100ms into kernel time, after mm_init so ioremap is
+ * safe) so the driver has time to probe and re-enable it properly via
+ * mtk_wdt_init().
+ */
+static int __init mt8167_wdt_early_disable(void)
+{
+	void __iomem *base;
+	u32 mode;
+
+	if (!of_machine_is_compatible("mediatek,mt8167") &&
+	    !of_machine_is_compatible("mediatek,mt8516"))
+		return 0;
+
+	base = ioremap(0x10007000, 0x100);
+	if (!base)
+		return 0;
+
+	mode = readl(base + WDT_MODE);
+	mode &= ~WDT_MODE_EN;
+	mode |= WDT_MODE_KEY;
+	writel(mode, base + WDT_MODE);
+	iounmap(base);
+	return 0;
+}
+early_initcall(mt8167_wdt_early_disable);
