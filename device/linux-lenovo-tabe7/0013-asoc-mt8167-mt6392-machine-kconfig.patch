diff -ruN a/sound/soc/mediatek/Kconfig b/sound/soc/mediatek/Kconfig
--- a/sound/soc/mediatek/Kconfig	2026-09-29 18:44:59.000000000 +0200
+++ b/sound/soc/mediatek/Kconfig	2026-10-11 02:21:49.133891063 +0200
@@ -96,6 +96,14 @@
 	  Select Y if you have such device.
 	  If unsure select "N".
 
+config SND_SOC_MT8167_MT6392
+	tristate "ASoC support for MT8167 boards with internal codec and MT6392 speaker amp"
+	depends on SND_SOC_MT8167 && SND_SOC_MT8167_CODEC && SND_SOC_MT6392_CODEC
+	help
+	  Sound card for MT8167 tablets that use only the SoC codec
+	  (headphone, microphones) and the MT6392 speaker amplifier,
+	  such as the Lenovo Tab E7 (TB-7104F).
+
 config SND_SOC_MT8167S_ES7243
 	tristate "ASoC support for Mediatek MT8167 chip with MT6392 ext spk amp and ES7243 ADC"
 	depends on ARCH_MEDIATEK && SND_SOC_ES7243 && SND_SOC_MT8167_CODEC && SND_SOC_MT6392_CODEC
diff -ruN a/sound/soc/mediatek/mt8167/Makefile b/sound/soc/mediatek/mt8167/Makefile
--- a/sound/soc/mediatek/mt8167/Makefile	2026-09-29 18:44:59.000000000 +0200
+++ b/sound/soc/mediatek/mt8167/Makefile	2026-10-11 02:21:49.133891063 +0200
@@ -6,4 +6,5 @@
 	mt8167-dai-adda.o
 
 obj-$(CONFIG_SND_SOC_MT8167) += snd-soc-mt8167-afe.o
-obj-$(CONFIG_SND_SOC_MT8167S_ES7243) += mt8167s-es7243.o
\ No newline at end of file
+obj-$(CONFIG_SND_SOC_MT8167S_ES7243) += mt8167s-es7243.o
+obj-$(CONFIG_SND_SOC_MT8167_MT6392) += mt8167-mt6392.o
