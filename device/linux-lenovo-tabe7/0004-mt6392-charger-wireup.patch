diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index b89ef40df..5d8bafa18 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -1202,4 +1202,15 @@ config MACSMC_POWER
 
 	  Say Y or M here if you have an Apple Silicon based Mac.
 
+config CHARGER_MT6392
+	tristate "MediaTek MT6392 PMIC charger"
+	depends on MFD_MT6397 || COMPILE_TEST
+	depends on REGMAP
+	help
+	  Say Y to enable support for the battery charger integrated into the
+	  MediaTek MT6392 PMIC, as found on MT8167 devices such as the Lenovo
+	  Tab E7. The PMIC runs the constant-voltage loop in hardware; this
+	  driver programs the limits, enables the charge path and feeds the
+	  charger watchdog.
+
 endif # POWER_SUPPLY
