 		},
-		.ops = &mtk_afe_fe_ops,
+		.ops = &mt8167_memif_dai_ops,
 	}, {
 		.name = "HDMI",
 		.id = MT8167_AFE_MEMIF_HDMI,
@@ -608,7 +671,7 @@
 				   SNDRV_PCM_FMTBIT_S24_LE |
