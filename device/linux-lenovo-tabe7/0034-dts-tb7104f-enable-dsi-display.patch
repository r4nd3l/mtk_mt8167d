 /*
- * mmsys stays enabled for its clock provider only: disp_pwm needs
- * CLK_MM_DISP_PWM_26M/MM and the MM power domain. The display pipeline
- * (ovl0, rdma0, dsi, mipi_tx) stays disabled so mediatek-drm never binds
- * and simpledrm keeps the LK-initialised panel.
+ * Display: OVL0 -> COLOR -> CCORR -> AAL -> GAMMA -> DITHER -> RDMA0 -> DSI0
+ * -> EK79007 panel. mediatek-drm, the DSI PHY and the panel driver are
+ * modules and blacklisted until the pipeline is proven, so simpledrm keeps
+ * the LK-initialised panel by default.
  */
 &mmsys { status = "okay"; };
-&ovl0 { status = "disabled"; };
-&rdma0 { status = "disabled"; };
 &wdma {	status = "disabled"; };
-&ccorr { status = "disabled"; };
-&aal { status = "disabled"; };
-&gamma { status = "disabled"; };
-&dither { status = "disabled"; };
 
 &disp_pwm {
 	status = "okay";
 };
 
