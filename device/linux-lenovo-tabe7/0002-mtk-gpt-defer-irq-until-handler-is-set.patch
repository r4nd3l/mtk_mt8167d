diff --git a/drivers/clocksource/timer-mediatek.c b/drivers/clocksource/timer-mediatek.c
index 0c717fac1..9fcfa1c32 100644
--- a/drivers/clocksource/timer-mediatek.c
+++ b/drivers/clocksource/timer-mediatek.c
@@ -318,6 +318,14 @@ static int __init mtk_gpt_init(struct device_node *node)
 	to.clkevt.suspend = mtk_gpt_suspend;
 	to.clkevt.resume = mtk_gpt_resume;
 	to.of_irq.handler = mtk_gpt_interrupt;
+	/*
+	 * The bootloader hands the GPT over still running with its interrupt
+	 * enabled, so a stale IRQ can be delivered the moment request_irq()
+	 * runs below. That is before clockevents_config_and_register() installs
+	 * clkevt->event_handler, and mtk_gpt_interrupt() would then call through
+	 * a NULL pointer. Keep the line masked until the clockevent is ready.
+	 */
+	to.of_irq.flags = IRQF_TIMER | IRQF_NO_AUTOEN;
 
 	ret = timer_of_init(node, &to);
 	if (ret)
@@ -336,7 +344,9 @@ static int __init mtk_gpt_init(struct device_node *node)
 	clockevents_config_and_register(&to.clkevt, timer_of_rate(&to),
 					TIMER_SYNC_TICKS, 0xffffffff);
 
+	/* Clears any interrupt the bootloader left pending, then enables ours. */
 	mtk_gpt_enable_irq(&to, TIMER_CLK_EVT);
+	enable_irq(timer_of_irq(&to));
 
 	return 0;
 }
